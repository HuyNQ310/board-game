# Host port mapped to container port 3000 in docker-compose.yml
# (When running locally without Docker, this is also the server listen port.)
PORT=3000

# Path to the SQLite database file.
# Inside Docker this defaults to /app/data/meo-no.sqlite (mounted to volume meo_no_data).
# For local development without Docker, ./data/meo-no.sqlite is used by default.
DB_PATH=/app/data/meo-no.sqlite

# Public canonical origin URL (no trailing slash) used for SEO metadata,
# Open Graph tags, sitemap/robots links, and reverse-proxy deployments.
# Example: https://meono.example.com
PUBLIC_URL=http://localhost:3000

# Grace period (milliseconds) before a disconnected player is removed/eliminated.
DISCONNECT_GRACE_MS=120000
